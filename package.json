{
  "name": "stardust-isles",
  "private": true,
  "version": "0.2.0",
  "description": "A cozy 3D exploration & collection game for the browser. Every model, sound and song is generated in code (Three.js).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Danzer1xxxxChan/Stardust_Isles.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "start": "node server/server.js",
    "test": "node tools/functest.mjs http://localhost:8080/",
    "test:combat": "node tools/combattest.mjs http://localhost:8080/",
    "i18n:check": "node tools/i18n/extract.mjs && node tools/i18n/shadow.mjs",
    "smoke": "node tools/smoke.mjs http://localhost:8080/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "vite": "^8.3.3"
  }
}
